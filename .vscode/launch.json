{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Depurar protocolo_http (MinGW)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\protocolo_http.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${env:USERPROFILE}\\scoop\\apps\\mingw\\current\\bin\\gdb.exe",
            "preLaunchTask": "Compilar protocolo_http (MinGW C++23)",
            "setupCommands": [
                {
                    "description": "Habilitar formatação amigável do GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
